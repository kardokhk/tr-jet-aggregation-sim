# Allowlist: only the simulation-study materials are tracked. Everything else in this
# directory (other workstreams, confidential material, scratch notes and unpublished manuscript
# drafts) stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE-DATA
!/CITATION.cff
!/run_all.sh
!/environment.md
!/environment-explicit.txt
!/requirements.txt
!/code/
!/tests/
!/results/
!/figures/
!/notes/
notes/*
!notes/parameter-table-2026-09-18.md
!notes/lab-notebook.md
!notes/code-sha256-2026-09-18-v02.txt
figures/superseded/
__pycache__/
*.pyc
.pytest_cache/

# clinical TEE example (patient image): manuscript Figure 1 only, never public
figures/fig1_design_tee*
code/14_prepare_tee_example.py
figures/fig1_design_alt.png
